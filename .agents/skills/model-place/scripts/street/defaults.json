{
  "osm": {
    "endpoints": [
      "https://overpass-api.de/api/interpreter",
      "https://overpass.kumi.systems/api/interpreter",
      "https://overpass.private.coffee/api/interpreter"
    ],
    "timeout": 150,
    "grace": 30,
    "retryPause": 1,
    "select": [
      "way[building]",
      "relation[building]",
      "way[highway]",
      "way[leisure]",
      "way[amenity]",
      "node[historic]",
      "node[tourism]",
      "node[natural=tree]",
      "node[highway=street_lamp]",
      "way[man_made]",
      "way[\"area:highway\"]"
    ]
  },
  "roads": ["primary", "secondary", "tertiary", "residential", "pedestrian", "unclassified", "living_street", "primary_link"],
  "curb": { "surface": "paving", "inset": 4, "minWidth": 5, "maxSlope": 0.08, "minOffset": 0, "outlier": null },
  "medians": { "smooth": 5, "minLength": 20, "maxStep": 7.5 },
  "signs": { "out": 0.2, "depth": 0.15 },
  "fronts": { "minSide": 1.5, "probe": 0.2, "start": 0.3, "length": 40, "reach": 30 },
  "candidates": { "margin": 2, "reach": 30, "front": 16, "levelHeight": 3.1, "levelBase": 2, "overlap": 0.3 },
  "footprints": {
    "corner": 4.0,
    "depth": 25.0,
    "walk": 7.5,
    "match": 6,
    "minFront": 3,
    "front": 18,
    "frontTolerance": 1.5,
    "shift": 30,
    "shiftCap": 8,
    "shiftWeight": 0.01,
    "overlap": -3,
    "radius": 5.0,
    "idLength": 40,
    "cutReach": 300,
    "weld": 0.05
  },
  "sidewalks": { "edge": 0.5, "gap": 3 },
  "rings": { "dedupe": 0.3, "collinear": 0.05, "decimals": 2 },
  "clear": { "minArea": 1, "share": 0.25 },
  "gameBuildings": { "margin": [500, 400] },
  "satellite": {
    "zoom": 19,
    "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
    "resolution": 0.25,
    "pause": 0.15,
    "timeout": 30,
    "ticks": { "minor": 10, "major": 50, "across": 10, "short": 8, "long": 16, "side": 12 },
    "font": 11,
    "colors": { "along": [255, 255, 0], "across": [0, 255, 255] }
  },
  "plan": {
    "scale": 3.0,
    "half": 130,
    "length": 330,
    "overlap": 20,
    "ticks": [25, 50],
    "font": 12,
    "roadWidth": 2,
    "shade": { "light": 235, "perMeter": 2.2, "dark": 60 },
    "colors": { "park": [205, 238, 205], "road": [160, 160, 160], "data": [30, 30, 140], "osm": [230, 90, 0], "rule": [255, 0, 0], "label": [0, 0, 0], "paper": [255, 255, 255] }
  },
  "mapillary": {
    "api": "https://graph.mapillary.com/images",
    "app": "https://www.mapillary.com/app/?pKey={id}&focus=photo",
    "tokenEnv": "MAPILLARY_TOKEN",
    "tokenHelp": "gratis: https://www.mapillary.com/dashboard/developers → Register application → Client Token",
    "fields": ["id", "captured_at", "compass_angle", "computed_compass_angle", "geometry", "computed_geometry", "camera_type", "camera_parameters", "width", "height", "is_pano", "on_foot", "quality_score", "creator", "thumb_2048_url"],
    "thumb": "thumb_2048_url",
    "panoTypes": ["equirectangular", "spherical"],
    "step": 100,
    "limit": 2000,
    "bin": 20,
    "perBin": 3,
    "side": 45,
    "staleYears": 3,
    "height": { "foot": 1.6, "vehicle": 2.2, "unknown": 2.0 },
    "pause": 0.2,
    "timeout": 60
  },
  "photos": {
    "extensions": [".jpg", ".jpeg", ".heic", ".heif", ".png"],
    "diagonal": 43.27,
    "height": 1.6,
    "side": 45,
    "staleYears": 3,
    "thumb": 1024,
    "quality": 85
  }
}
